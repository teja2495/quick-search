<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.telephony.calling"
        android:required="false" />

    <!-- Network Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Haptic Feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Usage Statistics Permissions -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Package Management Permissions -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Contact Permissions -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Storage Permissions -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:largeHeap="true"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuickSearch">

        <receiver
            android:name=".search.data.AppCatalogChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <action android:name="android.intent.action.PACKAGE_CHANGED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- Enable profiling for Android Profiler -->
        <profileable
            android:shell="true"
            android:enabled="true" />

        <!-- Home Activity: receives CATEGORY_HOME launches (home gesture / home
             button when this app is the default launcher). Uses the opaque theme
             variant so the Pixel home-gesture animation does not reveal the
             previous launcher behind a translucent window. Behavior is
             identical to MainActivity (it is a thin subclass). -->
        <activity
            android:name=".app.HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:resizeableActivity="true"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:theme="@style/Theme.QuickSearch.Opaque"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Main Activity: handles every other entry point (share, web search,
             ASSIST, process text, file view, app-icon launches from another
             launcher via the activity-aliases below). Keeps the translucent
             theme so it can sit on top of the previous app where appropriate. -->
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.QuickSearch"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.WEB_SEARCH" />
                <action android:name="android.intent.action.SEARCH" />
                <action android:name="android.search.action.GLOBAL_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data
                    android:scheme="content"
                    android:pathPattern=".*\\.quicksearch" />
                <data
                    android:scheme="file"
                    android:pathPattern=".*\\.quicksearch" />
                <data
                    android:scheme="content"
                    android:pathSuffix=".quicksearch" />
                <data
                    android:scheme="file"
                    android:pathSuffix=".quicksearch" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />
        </activity>

        <activity-alias
            android:name=".app.MainActivityAliasDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:targetActivity=".app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".app.MainActivityAliasMonochromeLight"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_monochrome_light"
            android:roundIcon="@mipmap/ic_launcher_monochrome_light"
            android:label="@string/app_name"
            android:targetActivity=".app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".app.MainActivityAliasMonochromeDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_monochrome_dark"
            android:roundIcon="@mipmap/ic_launcher_monochrome_dark"
            android:label="@string/app_name"
            android:targetActivity=".app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".app.MainActivityAliasForestLight"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_forest_light"
            android:roundIcon="@mipmap/ic_launcher_forest_light"
            android:label="@string/app_name"
            android:targetActivity=".app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".app.MainActivityAliasForestDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_forest_dark"
            android:roundIcon="@mipmap/ic_launcher_forest_dark"
            android:label="@string/app_name"
            android:targetActivity=".app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".app.MainActivityAliasAuroraLight"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_aurora_light"
            android:roundIcon="@mipmap/ic_launcher_aurora_light"
            android:label="@string/app_name"
            android:targetActivity=".app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".app.MainActivityAliasAuroraDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_aurora_dark"
            android:roundIcon="@mipmap/ic_launcher_aurora_dark"
            android:label="@string/app_name"
            android:targetActivity=".app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".app.MainActivityAliasSunsetLight"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sunset_light"
            android:roundIcon="@mipmap/ic_launcher_sunset_light"
            android:label="@string/app_name"
            android:targetActivity=".app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".app.MainActivityAliasSunsetDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sunset_dark"
            android:roundIcon="@mipmap/ic_launcher_sunset_dark"
            android:label="@string/app_name"
            android:targetActivity=".app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- Search Activities -->
        <activity
            android:name=".overlay.OverlayActivity"
            android:exported="${profileCaptureExported}"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.QuickSearch"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />

        <activity
            android:name=".searchEngines.SearchTargetQueryShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.QuickSearch" />

        <!-- Widget Activities -->
        <activity
            android:name=".widgets.searchWidget.SearchWidgetConfigureActivity"
            android:exported="false"
            android:label="@string/widget_settings_title"
            android:excludeFromRecents="true"
            android:finishOnTaskLaunch="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widgets.customButtonsWidget.WidgetActionActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.QuickSearch" />

        <activity
            android:name=".pinnedNotifications.PinnedNotificationPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.QuickSearch" />

        <activity
            android:name=".pinnedNotifications.PinnedNotificationChoiceActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.QuickSearch" />

        <receiver
            android:name=".pinnedNotifications.PinnedNotificationRestoreReceiver"
            android:exported="false" />

        <receiver
            android:name=".pinnedNotifications.PinnedNotificationUnpinReceiver"
            android:exported="false" />

        <receiver
            android:name=".pinnedNotifications.PinnedNotificationCopyContentReceiver"
            android:exported="false" />

        <!-- Widget Receivers -->
        <receiver
            android:name=".widgets.searchWidget.SearchWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.CONFIGURATION_CHANGED" />
                <action android:name="android.intent.action.WALLPAPER_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.customButtonsWidget.CustomButtonsWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_custom_buttons_widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.CONFIGURATION_CHANGED" />
                <action android:name="android.intent.action.WALLPAPER_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/custom_buttons_widget_info" />
        </receiver>

        <!-- Quick Settings Tile Service -->
        <service
            android:name=".search.searchScreen.LockScreenAccessibilityService"
            android:description="@string/accessibility_lock_screen_service_description"
            android:exported="true"
            android:label="@string/accessibility_lock_screen_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_screen_accessibility_service" />
        </service>

        <service
            android:name=".search.apps.notificationDots.NotificationDotsListenerService"
            android:exported="true"
            android:label="@string/notification_dots_toggle_title"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.QuickSearchTileService"
            android:exported="true"
            android:icon="@drawable/ic_widget_search"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
