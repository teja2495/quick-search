<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher scales this preview down. Live actions use the widget's full touch targets. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_media_controls_placeholder_background"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_media_controls_art_placeholder">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:alpha="0.7"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_media_controls_music_note"
                    android:tint="@color/widget_note_placeholder_content" />

            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_media_controls_nothing_playing"
                android:textColor="@color/widget_note_placeholder_content"
                android:textSize="15sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/media_seek_back"
                    android:src="@drawable/ic_media_controls_rewind"
                    android:tint="@color/widget_note_placeholder_content" />

            </FrameLayout>

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">

                <FrameLayout
                    android:layout_width="33dp"
                    android:layout_height="33dp"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_media_controls_outline_circle">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/media_command_previous"
                        android:src="@drawable/ic_media_controls_previous"
                        android:tint="@color/widget_note_placeholder_content" />

                </FrameLayout>

            </FrameLayout>

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">

                <FrameLayout
                    android:layout_width="33dp"
                    android:layout_height="33dp"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_media_controls_play_circle">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/media_command_play_pause"
                        android:src="@drawable/ic_media_controls_play"
                        android:tint="@color/widget_preview_on_content" />

                </FrameLayout>

            </FrameLayout>

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">

                <FrameLayout
                    android:layout_width="33dp"
                    android:layout_height="33dp"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_media_controls_outline_circle">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/media_command_next"
                        android:src="@drawable/ic_media_controls_next"
                        android:tint="@color/widget_note_placeholder_content" />

                </FrameLayout>

            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/media_seek_forward"
                    android:src="@drawable/ic_media_controls_fast_forward"
                    android:tint="@color/widget_note_placeholder_content" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
